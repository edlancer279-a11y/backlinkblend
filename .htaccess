<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt .md
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "(llms\.txt|llms-full\.txt)$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|js|css|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS & Domain Normalization (301 Permanent Redirect)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.backlinkblend\.com$ [NC]
  RewriteRule ^(.*)$ https://backlinkblend.com/$1 [R=301,L]

  # Direct Exclusions for Sitemap, Robots, & LLMs files (Do not rewrite)
  RewriteRule ^(sitemap\.xml|robots\.txt|llms\.txt|llms-full\.txt)$ - [L]

  # 301 Permanent Redirects for Old Indexed WordPress URLs & Feeds
  RewriteRule ^feed/?$ / [R=301,L]
  RewriteRule ^comments/feed/?$ / [R=301,L]
  RewriteRule ^about-us/?$ /about [R=301,L]
  RewriteRule ^write-for-us/?$ /contact [R=301,L]
  RewriteRule ^editors-pick-shopnaclo/?$ / [R=301,L]
  RewriteRule ^Business/?$ /category/business [R=301,L]
  RewriteRule ^2026/.*$ / [R=301,L]

  # 301 Permanent Redirects for Legacy Article Slugs (Resolves GSC duplicate folding into scary-ai)
  RewriteRule ^article/character-ai-age-verification-guide/?$ /article/character-ai-age-verification [R=301,L]
  RewriteRule ^character-ai-age-verification-guide/?$ /article/character-ai-age-verification [R=301,L]
  RewriteRule ^article/clever-ai-humanizer-review/?$ /article/clever-ai-humanizer [R=301,L]
  RewriteRule ^clever-ai-humanizer-review/?$ /article/clever-ai-humanizer [R=301,L]
  RewriteRule ^article/suno-ai/?$ /article/what-is-suno-ai-guide [R=301,L]
  RewriteRule ^suno-ai/?$ /article/what-is-suno-ai-guide [R=301,L]
  RewriteRule ^article/what-is-perplexity-ai-guide/?$ /article/perplexity-ai [R=301,L]
  RewriteRule ^what-is-perplexity-ai-guide/?$ /article/perplexity-ai [R=301,L]
  RewriteRule ^article/what-is-ai-hallucination-causes-prevention/?$ /article/ai-hallucination [R=301,L]
  RewriteRule ^what-is-ai-hallucination-causes-prevention/?$ /article/ai-hallucination [R=301,L]
  RewriteRule ^article/droven-io-ai-tools-2026-overview/?$ /article/droven-io [R=301,L]
  RewriteRule ^droven-io-ai-tools-2026-overview/?$ /article/droven-io [R=301,L]
  RewriteRule ^article/ai-image-generator-prompts-that-work/?$ /article/ai-image-prompts [R=301,L]
  RewriteRule ^ai-image-generator-prompts-that-work/?$ /article/ai-image-prompts [R=301,L]
  RewriteRule ^article/what-is-nerovet-ai-dentistry/?$ /article/nerovet-ai-dentistry [R=301,L]
  RewriteRule ^what-is-nerovet-ai-dentistry/?$ /article/nerovet-ai-dentistry [R=301,L]
  RewriteRule ^article/uk-government-microsoft-copilot-trial-roundup/?$ /article/uk-copilot-trial [R=301,L]
  RewriteRule ^uk-government-microsoft-copilot-trial-roundup/?$ /article/uk-copilot-trial [R=301,L]
  RewriteRule ^article/grok-video-moderated-meaning/?$ /article/grok-video-moderated [R=301,L]
  RewriteRule ^grok-video-moderated-meaning/?$ /article/grok-video-moderated [R=301,L]
  RewriteRule ^article/hammer-ai-explained/?$ /article/hammer-ai [R=301,L]
  RewriteRule ^hammer-ai-explained/?$ /article/hammer-ai [R=301,L]
  RewriteRule ^article/agentic-ai-pindrop-anonybit-explained/?$ /article/agentic-ai-pindrop-anonybit [R=301,L]
  RewriteRule ^agentic-ai-pindrop-anonybit-explained/?$ /article/agentic-ai-pindrop-anonybit [R=301,L]

  # SPA Routing Fallback for Single Page Application
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
