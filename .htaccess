<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt .md
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "(llms\.txt|llms-full\.txt)$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|js|css|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS & Domain Normalization (301 Permanent Redirect)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.backlinkblend\.com$ [NC]
  RewriteRule ^(.*)$ https://backlinkblend.com/$1 [R=301,L]

  # Direct Exclusions for Sitemap, Robots, Ads, & LLMs files (Do not rewrite)
  RewriteRule ^(sitemap\.xml|robots\.txt|llms\.txt|llms-full\.txt|ads\.txt|favicon\.ico)$ - [L]

  # Allow existing static assets directly (Never rewrite or block real files)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.(css|js|jpe?g|png|gif|webp|svg|ico|woff|woff2|ttf)$ - [L]

  # 1. SPIDER TRAP DEFENSE: Instantly 404 any crawler recursion loops with nested asset or category paths
  RewriteCond %{REQUEST_URI} /(css|js)/.+/(css|js)/ [NC,OR]
  RewriteCond %{REQUEST_URI} /(article|category)/.+/(article|category)/ [NC,OR]
  RewriteCond %{REQUEST_URI} /(css|js|assets)/.+\.(html|htm)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 2. STRICT ASSET PROTECTION: Missing static files must NEVER fall back to index.html (Return 404 immediately)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} \.(css|js|jpe?g|png|gif|webp|svg|ico|woff|woff2|ttf|eot|xml|txt|json|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 301 Permanent Redirects for Old Indexed WordPress URLs & Feeds
  RewriteRule ^feed/?$ / [R=301,L]
  RewriteRule ^comments/feed/?$ / [R=301,L]
  RewriteRule ^about-us/?$ /about [R=301,L]
  RewriteRule ^write-for-us/?$ /contact [R=301,L]
  RewriteRule ^editors-pick-shopnaclo/?$ / [R=301,L]
  RewriteRule ^Business/?$ /category/digital-authority [R=301,L]
  RewriteRule ^2026/.*$ / [R=301,L]

  # 301 Permanent Redirects for Legacy Category Slugs to Active Editorial Pillars
  RewriteRule ^category/technology/?$ /category/ai-automation [R=301,L]
  RewriteRule ^category/ai-agents/?$ /category/ai-automation [R=301,L]
  RewriteRule ^category/digital-marketing/?$ /category/digital-authority [R=301,L]
  RewriteRule ^category/business/?$ /category/digital-authority [R=301,L]
  RewriteRule ^category/finance/?$ /category/seo-tools [R=301,L]
  RewriteRule ^category/culture/?$ /category/link-building [R=301,L]

  # 301 Permanent Redirects for ALL Legacy Article Slugs (Resolves GSC Alternative & Discovered Issues)
  RewriteRule ^(article/)?what-is-blackbox-ai(-guide)?/?$ /article/blackbox-ai [R=301,L]
  RewriteRule ^(article/)?what-is-remaker-ai(-guide)?/?$ /article/remaker-ai [R=301,L]
  RewriteRule ^(article/)?what-is-viggle-ai(-guide)?/?$ /article/viggle-ai [R=301,L]
  RewriteRule ^(article/)?deep-ai-image-generator-guide/?$ /article/deep-ai-image-generator [R=301,L]
  RewriteRule ^(article/)?what-is-deep-ai(-guide)?/?$ /article/deep-ai [R=301,L]
  RewriteRule ^(article/)?deep-ai-guide/?$ /article/deep-ai [R=301,L]
  RewriteRule ^(article/)?character-ai-age-verification-guide/?$ /article/character-ai-age-verification [R=301,L]
  RewriteRule ^(article/)?clever-ai-humanizer-review/?$ /article/clever-ai-humanizer [R=301,L]
  RewriteRule ^(article/)?suno-ai/?$ /article/what-is-suno-ai-guide [R=301,L]
  RewriteRule ^(article/)?what-is-suno-ai/?$ /article/what-is-suno-ai-guide [R=301,L]
  RewriteRule ^(article/)?what-is-perplexity-ai(-guide)?/?$ /article/perplexity-ai [R=301,L]
  RewriteRule ^(article/)?what-is-ai-hallucination-causes-prevention/?$ /article/ai-hallucination [R=301,L]
  RewriteRule ^(article/)?droven-io-ai-tools-2026(-overview)?/?$ /article/droven-io [R=301,L]
  RewriteRule ^(article/)?ai-image-generator-prompts(-that-work)?/?$ /article/ai-image-prompts [R=301,L]
  RewriteRule ^(article/)?what-is-nerovet-ai-dentistry/?$ /article/nerovet-ai-dentistry [R=301,L]
  RewriteRule ^(article/)?uk-government-microsoft-copilot-trial(-roundup)?/?$ /article/uk-copilot-trial [R=301,L]
  RewriteRule ^(article/)?grok-video-moderated-meaning/?$ /article/grok-video-moderated [R=301,L]
  RewriteRule ^(article/)?hammer-ai-explained/?$ /article/hammer-ai [R=301,L]
  RewriteRule ^(article/)?agentic-ai-pindrop-anonybit-explained/?$ /article/agentic-ai-pindrop-anonybit [R=301,L]

  # 301 Permanent Redirects for Direct Root Slugs to Canonical /article/
  RewriteRule ^(how-to-optimize-content-for-google-ai-overviews|ahrefs-seo-tools-guide|seo-tools-guide|suno-ai-music-generation-guide|suno-ai-music-generation|suno-ai-vs-udio-guide|suno-ai-vs-udio|what-is-janitor-ai-guide|janitor-ai-guide|turnitin-ai-detector-guide|turnitin-ai-detector|what-is-poly-ai-guide|poly-ai-guide|what-is-google-notebooklm-guide|google-notebooklm-guide|luma-dream-machine-ai-guide|google-mixboard-guide|who-created-chatgpt|what-is-artificial-intelligence-guide|what-is-nectar-ai-guide|hp-probook-4-g1i-ai-pc-14|ai-content-audit-2026|google-september-2026-spam-update-guide|data-center-resilience-ai|best-books-for-critical-thinking|openai-careers-guide|what-is-seaart-ai-guide|what-is-hailuo-ai-video-guide|what-is-cursor-ai-guide|kling-ai-free|scary-ai|what-is-suno-ai-guide|blackbox-ai|viggle-ai|remaker-ai|deep-ai-image-generator|deep-ai|character-ai-age-verification|perplexity-ai|ai-hallucination|clever-ai-humanizer|claude-ai|droven-io|ai-image-prompts|nerovet-ai-dentistry|uk-copilot-trial|innocams-review|grok-video-moderated|enterprise-ai-agents|hammer-ai|agentic-ai-pindrop-anonybit|enterprise-ai-security)/?$ /article/$1 [R=301,L]

  # Normalize trailing slashes to clean canonical URLs (301 Permanent Redirect)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^article/([a-zA-Z0-9_-]+)/$ /article/$1 [R=301,L]
  RewriteRule ^category/([a-zA-Z0-9_-]+)/$ /category/$1 [R=301,L]
  RewriteRule ^(articles|about|contact|privacy|terms|disclaimer)/$ /$1 [R=301,L]

  # Direct internal rewrite for pre-rendered article pages (Serves 200 OK directly, avoids DirectorySlash)
  RewriteCond %{DOCUMENT_ROOT}/article/$1/index.html -f
  RewriteRule ^article/([a-zA-Z0-9_-]+)$ article/$1/index.html [L]

  # Direct internal rewrite for pre-rendered category hubs
  RewriteCond %{DOCUMENT_ROOT}/category/$1/index.html -f
  RewriteRule ^category/([a-zA-Z0-9_-]+)$ category/$1/index.html [L]

  # Direct internal rewrite for pre-rendered articles repository hub
  RewriteCond %{DOCUMENT_ROOT}/articles/index.html -f
  RewriteRule ^articles$ articles/index.html [L]

  # Direct internal rewrite for static info pages
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(about|contact|privacy|terms|disclaimer)$ $1/index.html [L]

  # SPA Routing Fallback for Single Page Application (Strictly for non-asset HTML routes)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(css|js|jpe?g|png|gif|webp|svg|ico|woff|woff2|ttf|eot|xml|txt|json|map)$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>
